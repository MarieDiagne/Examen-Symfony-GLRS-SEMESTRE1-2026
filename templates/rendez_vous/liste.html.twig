{# templates/rendez_vous/liste.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <div class="row align-items-center">
            <div class="col">
                <h3 class="mb-0 text-primary fw-bold text-uppercase" style="letter-spacing: 1px;">
                    Demandes de Rendez-vous
                </h3>
            </div>
            <div class="col-auto">
                <form method="get" class="d-flex align-items-center gap-2">
                    <label class="text-muted small fw-bold text-nowrap">Filtrer par :</label>
                    <select name="etat" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">Tous les états</option>
                        <option value="En attente" {{ etat_actuel == 'En attente' ? 'selected' }}>⏳ En attente</option>
                        <option value="Validée" {{ etat_actuel == 'Validée' ? 'selected' }}>✅ Validée</option>
                        <option value="Annulée" {{ etat_actuel == 'Annulée' ? 'selected' }}>❌ Annulée</option>
                    </select>
                </form>
            </div>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Patient</th>
                        <th>Date Souhaitée</th>
                        <th>Prestation</th>
                        <th>Spécialité</th>
                        <th>Statut</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for demande in demandes %}
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">{{ demande.patient.nom }}</div>
                                <div class="small text-muted">{{ demande.patient.prenom }}</div>
                            </td>
                            <td>
                                <span class="badge bg-info text-dark">{{ demande.dateSouhaitee|date('d/m/Y') }}</span>
                            </td>
                            <td>{{ demande.typePrestation.value|default(demande.typePrestation) }}</td>
                            <td>{{ demande.specialite.value|default(demande.specialite) }}</td>
                            <td>
                                {% set statut = demande.statut.value|default(demande.statut) %}
                                {% if statut == 'En attente' %}
                                    <span class="badge rounded-pill bg-warning text-dark px-3">En attente</span>
                                {% elseif statut == 'Validée' %}
                                    <span class="badge rounded-pill bg-success px-3">Validée</span>
                                {% else %}
                                    <span class="badge rounded-pill bg-danger px-3">Annulée</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                {% if statut == 'En attente' %}
                                    <div class="btn-group btn-group-sm">
                                        <a href="{{ path('app_rdv_valider', {id: demande.id}) }}" class="btn btn-outline-success">
                                            Valider
                                        </a>
                                        <button class="btn btn-outline-danger">
                                            Annuler
                                        </button>
                                    </div>
                                {% else %}
                                    <span class="text-muted small italic">Aucune action</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <p class="mb-0">🚫 Aucune demande enregistrée pour le moment.</p>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}